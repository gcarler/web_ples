# -----------------------------------------------------------------------------
# Firebase Admin SDK Configuration (for Server-Side Actions)
# -----------------------------------------------------------------------------
# This is a service account key used for server-side operations (e.g., user management).
# INSTRUCTIONS:
# 1. Go to your Firebase project console: https://console.firebase.google.com/
# 2. Click the gear icon > "Project settings" > "Service accounts" tab.
# 3. Click "Generate new private key". A JSON file will be downloaded.
# 4. Open the JSON file and copy the values into a NEW file named `.env.local` in the root of your project.

# Get this value from the "project_id" field in your downloaded JSON file.
FIREBASE_PROJECT_ID=

# Get this value from the "client_email" field in your downloaded JSON file.
FIREBASE_CLIENT_EMAIL=

# ** IMPORTANT: Private Key Formatting **
# The private_key must be formatted as a single line in your .env.local file.
# 1. Copy the entire private_key value from the JSON file (it starts with "-----BEGIN PRIVATE KEY-----").
# 2. Replace ALL newline characters (`\n`) with the literal string `\n`.
# 3. The entire value MUST be enclosed in double quotes.
#
# EXAMPLE:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"
#
FIREBASE_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# Firebase Web App Configuration (for Client-Side SDK)
# -----------------------------------------------------------------------------
# This is for the client-side Firebase SDK (authentication, Firestore on the client).
# INSTRUCTIONS:
# 1. Go to your Firebase project console: https://console.firebase.google.com/
# 2. Click the gear icon > "Project settings" > "General" tab.
# 3. Scroll down to the "Your apps" section.
# 4. Find your Web app and look for the "SDK setup and configuration" section.
# 5. Select the "Config" option and copy the values into your `.env.local` file.

# NOTE: The NEXT_PUBLIC_ prefix is required to expose these to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# -----------------------------------------------------------------------------
# Google Generative AI API Key (for Genkit)
# -----------------------------------------------------------------------------
# This is for using Generative AI features like Gemini.
# INSTRUCTIONS:
# 1. Ensure the "Generative Language API" is enabled in your Google Cloud project.
# 2. Go to the "APIs & Services" > "Credentials" page in your Google Cloud Console.
# 3. Click "+ CREATE CREDENTIALS" and select "API key".
# 4. Copy the key and paste it here in your `.env.local` file.
#
GOOGLE_GENAI_API_KEY=
