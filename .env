# -----------------------------------------------------------------------------
# Firebase Web SDK Configuration (Client-Side)
# -----------------------------------------------------------------------------
# These keys are safe to be exposed to the client (hence NEXT_PUBLIC_ prefix).
# Find these values in your Firebase project settings:
# Project Settings > General > Your apps > Firebase SDK snippet > Config
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# -----------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Server-Side)
# -----------------------------------------------------------------------------
# These keys are SECRET and should never be exposed to the client.
# Find these values in your Firebase project's service account JSON file:
# Project Settings > Service accounts > Generate new private key
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"
# IMPORTANT: When copying the private key, enclose it in quotes and replace
# all newline characters (\n) with the literal characters \\n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Google AI (Genkit) Configuration
# -----------------------------------------------------------------------------
# This key is SECRET and should never be exposed to the client.
# Get this from Google AI Studio: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GOOGLE_GENAI_API_KEY="your-google-genai-api-key"
