# ------------------------------------------------------------------
# Firebase Admin SDK Configuration (for Server-Side operations)
# ------------------------------------------------------------------
# These variables are used for server-side actions like user management and content editing.
# You MUST get these from a Firebase Service Account JSON key file.
#
# How to get these values:
# 1. Go to your Firebase Project Settings > Service accounts.
# 2. Select your Node.js app.
# 3. Click "Generate new private key". A JSON file will be downloaded.
# 4. Open the JSON file and copy the corresponding values below.

# From "project_id" in your JSON file
FIREBASE_PROJECT_ID=

# From "client_email" in your JSON file
FIREBASE_CLIENT_EMAIL=

# From "private_key" in your JSON file.
# IMPORTANT: When you copy the private key, it will have newline characters (\n).
# It must be enclosed in double quotes ("") to ensure it's read correctly.
FIREBASE_PRIVATE_KEY=


# ------------------------------------------------------------------
# Firebase Web SDK Configuration (for Client-Side operations)
# ------------------------------------------------------------------
# These variables are for client-side features like login and authentication.
# They are prefixed with NEXT_PUBLIC_ to be exposed to the browser.
#
# How to get these values:
# 1. Go to your Firebase Project Settings > General.
# 2. Scroll to the "Your apps" section and select your web app.
# 3. Choose the "Config" option for SDK setup.
# 4. Copy the values into the variables below.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=


# ------------------------------------------------------------------
# Genkit and Google AI Configuration (for Generative AI features)
# ------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=
