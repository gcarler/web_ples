# .env

# This file is for storing environment variables.
# For security reasons, NEVER commit this file to your repository.
# Add this file to your .gitignore to prevent it from being tracked.

# --------------------------------------------------
# Firebase Client SDK Configuration
# --------------------------------------------------
# These keys are used on the client-side (in the browser) for things like
# login, authentication, and interacting with Firestore from the client.
# They are prefixed with NEXT_PUBLIC_ to be exposed to the browser.
# 
# How to get them:
# 1. Go to your Firebase project: https://console.firebase.google.com/
# 2. Click the gear icon (Project settings) in the top left.
# 3. Under the "General" tab, scroll down to "Your apps".
# 4. Find your web app and copy the configuration values.

NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-auth-domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="web-ples"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-storage-bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# --------------------------------------------------
# Firebase Admin SDK Configuration (Server-Side)
# --------------------------------------------------
# These keys are used on the server-side for administrative tasks like creating users.
# They should NOT be prefixed with NEXT_PUBLIC_ as they must remain secret.
#
# How to get them:
# 1. In your Firebase project settings, go to the "Service accounts" tab.
# 2. Click "Generate new private key". A JSON file will be downloaded.
# 3. Open the JSON file and copy the corresponding values here.

FIREBASE_PROJECT_ID="web-ples"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@web-ples.iam.gserviceaccount.com"
